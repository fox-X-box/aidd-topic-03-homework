# Names and non-secret development defaults only. Export values before starting.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=investing
DB_USER=postgres
DB_PASSWORD=postgres
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Supply privately only when enabling live market data:
# TINKOFF_TOKEN=
# DJANGO_SECRET_KEY=
